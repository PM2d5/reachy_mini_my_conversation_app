# Optional realtime input transcription language.
# Defaults to "en". Set to a backend-supported code such as "zh" for Chinese.
# REALTIME_TRANSCRIPTION_LANGUAGE="en"

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Realtime backend selector: "huggingface" (default) or "dashscope".
# DashScope uses Alibaba Qwen-Omni-Realtime, which natively transcribes and speaks Chinese.
# REALTIME_BACKEND="dashscope"

# Alibaba DashScope settings, used when REALTIME_BACKEND=dashscope.
# DASHSCOPE_API_KEY=
# DASHSCOPE_REALTIME_MODEL="qwen3.5-omni-flash-realtime"
# DASHSCOPE_REALTIME_WS_BASE="wss://dashscope.aliyuncs.com/api-ws/v1"
# Optional default voice. Full list: https://help.aliyun.com/zh/model-studio/omni-voice-list
# qwen3.5 models use e.g. Tina, Ethan, Serena, Momo, Evan; Cherry/Chelsie are qwen3/turbo only.
# DASHSCOPE_REALTIME_VOICE="Tina"

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# Wake word mode: only listen after the wake word is detected, instead of always listening.
# Pretrained openWakeWord models (e.g. hey_mycroft, hey_jarvis, alexa) are downloaded on first run;
# comma-separated entries may also be paths to custom .onnx/.tflite model files (e.g. for Chinese wake words).
# REACHY_MINI_WAKE_WORD_ENABLED=1
# REACHY_MINI_WAKE_WORD_MODELS=hey_mycroft
# Detection sensitivity threshold, 0..1 (lower = more sensitive). Default 0.5.
# REACHY_MINI_WAKE_WORD_THRESHOLD=0.5
# Debug: directory to dump standby mic audio as a 16 kHz wav for offline wake word testing.
# REACHY_MINI_WAKE_WORD_DUMP_DIR=/tmp/wake_word_debug
# Seconds without conversation activity before active listening ends and the app returns to
# wake word standby. Default 300 (5 minutes), 0 disables the idle exit.
# REACHY_MINI_WAKE_WORD_ACTIVE_TIMEOUT_S=300
# Comma-separated keywords in a user transcript that end active listening (case-insensitive).
# REACHY_MINI_GOODBYE_KEYWORDS=再见,拜拜,goodbye,bye-bye,bye bye
